<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="ASISM framework" id="asism-framework">
    <mxGraphModel dx="1000" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Overview of the proposed ASISM framework" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="450" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Stage 1 — SDXL fine-tuning (LoRA)&#10;CheXpert-derived captions · gen_train / gen_val" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="44" width="360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Stage 2 — synthetic generation&#10;class-aware recipes · rarity-aware quotas · ~5k images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="128" width="360" height="52" as="geometry" />
        </mxCell>

        <mxCell id="asismbg" value="Stage 3 — ASISM (novel contribution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;fontSize=12;fontStyle=2;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="216" width="510" height="600" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="01 — six per-image signals&#10;similarity · image quality · uncertainty ·&#10;explainability · intended-label agreement · distinctiveness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="244" width="450" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="02 — Go / No-Go gate&#10;include · ablation-only · exclude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="332" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="04 — measure ~120 controlled subsets&#10;real ΔAUROC = augmented − real-only, on asism_tuning_heldout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="400" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="05 — set-utility network → per-image target&#10;permutation-invariant Deep Sets · leave-one-out / Data-Banzhaf MSR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="474" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="05 — multi-signal utility ranking network&#10;9 → 128 → 64 → 32 → 1 · one scalar utility score per image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="548" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="07–08 — adaptive per-class admission threshold&#10;class embedding + context → sigmoid&#10;three-tier governance (learned / verified-proxy / fixed baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="622" width="450" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="08b–09 — full-policy proxy comparison&#10;fixed · FreeMatch-style · learned network → one winning policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="selected synthetic subset — adaptive_selected_manifest.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="778" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="Stage 4 — train conditions&#10;A: real · B: real + all synthetic · F: real + ASISM-selected · D: real + matched-random" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="852" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Stage 5 — evaluation&#10;macro-AUROC on final_eval_heldout · primary comparison F vs B · D isolates selection quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="944" width="450" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note" value="All Stage 3 tuning uses asism_tuning_heldout only;&#10;final_eval_heldout is opened once, in Stages 4–5." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="1024" width="450" height="40" as="geometry" />
