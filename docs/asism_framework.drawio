<mxfile host="app.diagrams.net">
  <diagram name="ASISM framework" id="asism-framework">
    <mxGraphModel dx="1144" dy="624" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" value="Overview of the proposed ASISM framework" vertex="1">
          <mxGeometry height="24" width="450" x="200" y="10" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Stage 1 — SDXL fine-tuning (LoRA)&#xa;CheXpert-derived captions · gen_train / gen_val" vertex="1">
          <mxGeometry height="52" width="360" x="245" y="44" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Stage 2 — synthetic generation" vertex="1">
          <mxGeometry height="52" width="360" x="245" y="128" as="geometry" />
        </mxCell>
        <mxCell id="asismbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;fontSize=12;fontStyle=2;align=left;spacingLeft=10;spacingTop=6;" value="Stage 3 — ASISM (novel contribution)" vertex="1">
          <mxGeometry height="612" width="510" x="170" y="216" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="01 — six per-image signals&#xa;similarity · image quality · uncertainty ·&#xa;explainability · intended-label agreement · distinctiveness&#xa;+ near-duplicate rejection at DINOv2 cosine ≥ 0.95" vertex="1">
          <mxGeometry height="78" width="450" x="200" y="244" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="02 — Go / No-Go gate&#xa;per signal: include · ablation-only · exclude" vertex="1">
          <mxGeometry height="46" width="450" x="200" y="344" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="04 — build ~120 synthetic subsets and measure each one's effect&#xa;classifier macro-AUROC (real + subset) − macro-AUROC (real only)&#xa;scored on the asism_tuning_heldout split · these are the targets for 05" vertex="1">
          <mxGeometry height="64" width="450" x="200" y="404" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="05 — set-utility network → per-image target&#xa;permutation-invariant Deep Sets · leave-one-out / Data-Banzhaf MSR" vertex="1">
          <mxGeometry height="52" width="450" x="200" y="486" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="05 — multi-signal utility ranking network&#xa;six ASISM signals (nine feature columns) → MLP 128 → 64 → 32 → 1&#xa;one scalar utility score per image" vertex="1">
          <mxGeometry height="56" width="450" x="200" y="560" as="geometry" />
        </mxCell>
        <mxCell id="a6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="07–08 — adaptive per-class admission threshold&#xa;class embedding + per-class context → sigmoid&#xa;three-tier governance: learned net / verified-proxy / fixed baseline" vertex="1">
          <mxGeometry height="66" width="450" x="200" y="638" as="geometry" />
        </mxCell>
        <mxCell id="a7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="08b–09 — full-policy proxy comparison&#xa;candidate policies (fixed-ratio · top-50% · FreeMatch-style · learned net)&#xa;→ one winning policy (proxy evidence, asism_tuning_heldout only)" vertex="1">
          <mxGeometry height="66" width="450" x="200" y="726" as="geometry" />
        </mxCell>
        <mxCell id="a8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="selected synthetic subset — adaptive_selected_manifest.jsonl" vertex="1">
          <mxGeometry height="28" width="450" x="200" y="798" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Stage 4 — train conditions A / B / C&lt;br&gt;A: real   ·   B: real + all synthetic   ·   C: real + ASISM-selected" vertex="1">
          <mxGeometry height="62" width="450" x="200" y="864" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Stage 5 — evaluation&lt;br&gt;macro-AUROC on final_eval_heldout · primary comparison C vs B&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="62" width="450" x="200" y="958" as="geometry" />
        </mxCell>
        <mxCell id="lg" parent="1" style="text;html=1;align=left;fontSize=11;fontStyle=1;" value="Legend" vertex="1">
          <mxGeometry height="18" width="130" x="690" y="244" as="geometry" />
        </mxCell>
