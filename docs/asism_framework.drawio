  <diagram name="ASISM — simple overview" id="asism-simple">
    <mxGraphModel dx="1000" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" vertex="1" value="Adaptive Quality-Aware Synthetic Data Selection (ASISM) — framework overview" style="text;html=1;align=center;fontSize=14;fontStyle=1;">
          <mxGeometry x="120" y="16" width="610" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" vertex="1" value="Stage 1 — fine-tune a diffusion foundation model&#xa;SDXL + LoRA on CheXpert chest X-rays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="245" y="56" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" vertex="1" value="Stage 2 — generate synthetic data&#xa;label-conditioned synthetic chest X-rays (~5k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="245" y="136" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" vertex="1" value="Stage 3 — ASISM (novel contribution)&#xa;• score each synthetic image on six quality signals&#xa;• learn a per-image utility ranker from measured downstream AUROC&#xa;• apply an adaptive per-class admission threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=0;align=left;spacingLeft=12;">
          <mxGeometry x="205" y="216" width="440" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" vertex="1" value="selected synthetic subset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="285" y="338" width="280" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" vertex="1" value="Stage 4 — train the classifier under three conditions&#xa;A: real only   ·   B: real + all synthetic   ·   C: real + ASISM-selected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="215" y="402" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="1" vertex="1" value="Stage 5 — evaluate on the held-out test set&#xa;macro-AUROC over the disease labels · primary comparison C vs B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="215" y="484" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pn" parent="1" vertex="1" value="ASISM tunes only on a dedicated proxy split; the final test set is opened once, in Stage 5." style="text;html=1;align=center;fontSize=11;fontStyle=2;">
          <mxGeometry x="150" y="556" width="550" height="22" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" edge="1" source="p1" target="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" parent="1" edge="1" source="p2" target="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" parent="1" edge="1" source="p3" target="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" parent="1" edge="1" source="p4" target="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q5" parent="1" edge="1" source="p5" target="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q6" parent="1" edge="1" source="p2" target="p5" value="all synthetic (B)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6c8ebf;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.2;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
