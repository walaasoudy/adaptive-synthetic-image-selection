<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="ASISM framework" id="asism-framework">
    <mxGraphModel dx="1212" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" vertex="1" value="Overview of the proposed ASISM framework" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;">
          <mxGeometry x="200" y="10" width="450" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" parent="1" vertex="1" value="Stage 1 — SDXL fine-tuning (LoRA)&#xa;CheXpert-derived captions · gen_train / gen_val" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="245" y="44" width="360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" vertex="1" value="Stage 2 — synthetic generation&#xa;class-aware recipes · rarity-aware quotas · ~5k images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="245" y="128" width="360" height="52" as="geometry" />
        </mxCell>

        <mxCell id="asismbg" parent="1" vertex="1" value="Stage 3 — ASISM (novel contribution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;fontSize=12;fontStyle=2;align=left;spacingLeft=10;spacingTop=6;">
          <mxGeometry x="170" y="216" width="510" height="612" as="geometry" />
        </mxCell>

        <mxCell id="a1" parent="1" vertex="1" value="01 — six per-image signals&#xa;similarity · image quality · uncertainty ·&#xa;explainability · intended-label agreement · distinctiveness&#xa;+ near-duplicate rejection at DINOv2 cosine ≥ 0.95" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="200" y="244" width="450" height="78" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" vertex="1" value="02 — Go / No-Go gate&#xa;per signal: include · ablation-only · exclude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="200" y="344" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" vertex="1" value="04 — measure ~120 controlled subsets&#xa;real ΔAUROC = augmented − real-only, on asism_tuning_heldout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="200" y="412" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" vertex="1" value="05 — set-utility network → per-image target&#xa;permutation-invariant Deep Sets · leave-one-out / Data-Banzhaf MSR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="200" y="486" width="450" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" vertex="1" value="05 — multi-signal utility ranking network&#xa;six ASISM signals (nine feature columns) → MLP 128 → 64 → 32 → 1&#xa;one scalar utility score per image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="200" y="560" width="450" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a6" parent="1" vertex="1" value="07–08 — adaptive per-class admission threshold&#xa;class embedding + per-class context → sigmoid&#xa;three-tier governance: learned net / verified-proxy / fixed baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="200" y="638" width="450" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a7" parent="1" vertex="1" value="08b–09 — full-policy proxy comparison&#xa;candidate policies (fixed-ratio · top-50% · FreeMatch-style · learned net)&#xa;→ one winning policy (proxy evidence, asism_tuning_heldout only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="200" y="726" width="450" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a8" parent="1" vertex="1" value="selected synthetic subset — adaptive_selected_manifest.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="200" y="798" width="450" height="28" as="geometry" />
        </mxCell>

        <mxCell id="s4" parent="1" vertex="1" value="Stage 4 — train conditions A / B / C&#xa;A: real   ·   B: real + all synthetic   ·   C: real + ASISM-selected&#xa;(optional control D: real + matched-random subset of C's size &amp; class mix — off by default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="200" y="864" width="450" height="62" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" vertex="1" value="Stage 5 — evaluation&#xa;macro-AUROC on final_eval_heldout · primary comparison C vs B&#xa;(D, if enabled, isolates selection quality from subset size)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="200" y="958" width="450" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="All Stage 3 tuning uses asism_tuning_heldout only; final_eval_heldout is opened once, in Stages 4–5." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;">
          <mxGeometry x="200" y="1030" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lg" parent="1" vertex="1" value="Legend" style="text;html=1;align=left;fontSize=11;fontStyle=1;">
          <mxGeometry x="690" y="244" width="130" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" vertex="1" value="per-image scoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;">
          <mxGeometry x="690" y="266" width="140" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" vertex="1" value="learned utility &amp; threshold" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;">
          <mxGeometry x="690" y="298" width="140" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" vertex="1" value="data in / out (stages)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;">
          <mxGeometry x="690" y="330" width="140" height="26" as="geometry" />
        </mxCell>

